# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# Environments & virtualenvs
.venv/
venv/
env/
ENV/

# Playwright browser binaries
.playwright-browsers/

# Node dependencies
node_modules/

