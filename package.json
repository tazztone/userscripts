{
  "name": "userscripts-monorepo",
  "version": "1.0.0",
  "description": "Userscripts collection and developer tooling",
  "private": true,
  "scripts": {
    "build": "npm --prefix toppreise run build",
    "check": "npm --prefix toppreise run check",
    "lint": "npm --prefix toppreise run lint",
    "test": "npm --prefix toppreise test && node --test huggingface/tests/test_logic.js",
    "test:unit": "npm --prefix toppreise run test:unit",
    "test:toppreise": "npm --prefix toppreise test",
    "test:hf": "node --test huggingface/tests/test_logic.js"
  }
}
